{
  "name": "tuner",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Self-hosted IPTV player: React client, Fastify API, Postgres catalog.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @tuner/api",
    "dev:web": "npm run dev -w @tuner/web",
    "build": "npm run build -w @tuner/api && npm run build -w @tuner/web",
    "lint": "npm run lint --workspaces --if-present",
    "migrate": "npm run migrate -w @tuner/api",
    "migrate:down": "npm run migrate:down -w @tuner/api",
    "sync": "npm run sync -w @tuner/api",
    "health": "npm run health -w @tuner/api"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3"
  }
}
