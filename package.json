{
  "name": "tuner",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Self-hosted IPTV player: React client, Fastify API, Postgres catalog.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "migrate": "pnpm --filter @tuner/api migrate",
    "migrate:down": "pnpm --filter @tuner/api migrate:down",
    "sync": "pnpm --filter @tuner/api sync",
    "health": "pnpm --filter @tuner/api health",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "check": "pnpm lint && turbo run typecheck test"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
