{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "useDefineForClassFields": true,
    "tsBuildInfoFile": "./node_modules/.tmp/web.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@tuner/shared": ["../../packages/shared/src/index.ts"],
      "@tuner/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "tests"]
}
