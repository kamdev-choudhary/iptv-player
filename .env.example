# ─── Database ────────────────────────────────────────────────────────────────
# A local Postgres 16 or newer. See deploy/ for the VPS setup.
DATABASE_URL=postgres://tuner:tuner@localhost:5432/tuner
DATABASE_POOL_MAX=10
# Apply pending migrations when the API boots. Fine on one box.
MIGRATE_ON_BOOT=true

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080
# Comma-separated origins, or * . In production the client is same-origin.
CORS_ORIGIN=http://localhost:5173
# Serve the built client from the API instead of a separate web server.
SERVE_WEB=false
WEB_ROOT=../web/dist

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Signs the upstream URLs inside rewritten playlists. Without it the segment
# route would relay any URL handed to it, which is an open proxy.
#   openssl rand -hex 32
STREAM_SECRET=

# Bearer token for /admin/*. Unset means the admin API is refused outright.
#   openssl rand -hex 32
ADMIN_TOKEN=

# Optional. When set, the stream proxy requires it too — this is what makes a
# public deployment yours rather than everyone's. Leave empty for an open player.
STREAM_TOKEN=

# ─── Proxy limits ────────────────────────────────────────────────────────────
UPSTREAM_TIMEOUT_MS=15000
# Simultaneous upstream stream fetches. Video is the one thing here that
# arrives faster than it can be forgotten, so the number is capped.
PROXY_MAX_CONCURRENT=200
# Proxy requests per minute per IP.
PROXY_RATE_LIMIT=600

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Set false on extra API replicas so only one box runs the jobs.
RUN_JOBS=true
# iptv-org rebuilds daily; pick it up a little after.
SYNC_CRON=30 5 * * *
HEALTH_CRON=0 */6 * * *
IPTV_ORG_API=https://iptv-org.github.io/api
