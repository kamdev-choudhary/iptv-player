# TLS, and the security headers the application cannot set for itself.
#
# The API deliberately ships no Content-Security-Policy: the player loads logos
# from hundreds of broadcaster domains and video from as many more, so a useful
# policy can only be written where the deployment's own origin is known — here.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy fmt --overwrite /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

tuner.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# `media-src *` is the point of the whole application; `connect-src *`
		# is what lets the player try a broadcaster directly before falling back
		# to the proxy, which is what keeps bandwidth off this box.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: http:; media-src 'self' blob: https: http:; connect-src 'self' https: http:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'wasm-unsafe-eval'; frame-ancestors 'none'"
	}

	# A segment streams for as long as the viewer watches, so nothing is
	# buffered and nothing times out mid-programme.
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		transport http {
			response_header_timeout 30s
		}
	}
}
