# The API, which also serves the built client.
#
#   sudo cp deploy/tuner.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tuner
#
# The scheduled jobs run inside this process (RUN_JOBS=true), so there are no
# timers to install alongside it.

[Unit]
Description=Tuner — IPTV catalog, stream proxy and player
Documentation=https://github.com/kamdev-choudhary/iptv-player
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=tuner
Group=tuner
WorkingDirectory=/srv/tuner
EnvironmentFile=/srv/tuner/.env
Environment=NODE_ENV=production
Environment=SERVE_WEB=true
Environment=WEB_ROOT=/srv/tuner/apps/web/dist
ExecStart=/usr/bin/node apps/api/dist/index.js

Restart=always
RestartSec=5
# A viewer mid-segment is a real person, so the process is given time to drain.
KillSignal=SIGTERM
TimeoutStopSec=20

# It needs the network, a database socket and its own read-only code. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/srv/tuner/.turbo

# Video arrives faster than it can be forgotten; cap the process rather than
# letting one busy evening take the box down.
MemoryMax=2G
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tuner

[Install]
WantedBy=multi-user.target
